# ─────────────────────────────────────────────────────────
# PuzzleMaster Order Automation — Environment Configuration
# Copy this file to ".env" and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── IMAP (incoming mail) ──────────────────────────────────
IMAP_SERVER=your_host_here
EMAIL_USER=your_address_here
EMAIL_PASS=your_email_password_here

# ── Email filtering ───────────────────────────────────────
SENDER_FILTER=your_sender_here
SUBJECT_FILTER=your_filter_here

# ── Admin site ────────────────────────────────────────────
ADMIN_BASE_URL=start_of_url_before_differs_for_each_order

# ── Chrome CDP ───────────────────────────────────────────
CDP_URL=http://localhost:9222

# ── Alert emails (optional but recommended) ──────────────
# Where to send error/crash alerts
ALERT_EMAIL=your_alert_email@example.com
# SMTP credentials for sending alerts (e.g. a Gmail app password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ── Behaviour tweaks ──────────────────────────────────────
# How often to check email (seconds)
CHECK_INTERVAL=300
# How many times to retry a failed print before alerting
MAX_RETRIES=3
# How many print copies per order
PRINT_COPIES=2
# Seconds to wait between print copies
PRINT_DELAY=5
# Days before old order IDs are pruned from the processed list
ORDER_TTL_DAYS=30
